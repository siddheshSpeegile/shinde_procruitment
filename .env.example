# Copy to .env
# Base path the browser calls. Keep "/api" to use the Vite proxy (no CORS needed).
# Use a full URL (http://localhost:5000/api) to call Flask directly; Flask has CORS enabled for all origins.
VITE_API_BASE_URL=/api
# Production (set in the Render dashboard or render.yaml, not in a file):
# VITE_API_BASE_URL=https://shinde-procruitment.onrender.com/api

# Where the Vite dev server forwards /api and /uploads
VITE_PROXY_TARGET=http://localhost:5000

# backend = resolve permissions from /api/roles + /api/roles/:id/permissions (Administrator always gets everything)
# open    = every signed-in user sees everything (use while you are checking connectivity)
VITE_PERMISSION_MODE=backend

# Screens with no backend endpoint yet. true = browser-only sample data, labelled MOCK.
VITE_MOCK_USERS=true
VITE_MOCK_HOLD_LIST=true
